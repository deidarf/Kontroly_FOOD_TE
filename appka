<!doctype html>
<html lang="cs"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kontroly zásob</title>
<style>
:root{--bg:#f3f4f7;--fg:#161a26;--card:#fff;--bd:#dfe2ea;--ac:#14305f;--bt:#fff;--pk:#d6247b;--bad:#fdecee;--badb:#d64550;--ok:#e9f6ee;--okb:#2e9d5b;--mut:#6a7185;--sh:0 1px 2px rgba(20,30,60,.06),0 4px 14px rgba(20,30,60,.06);box-sizing:border-box;color-scheme:light}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1219;--fg:#eceef4;--card:#1a1e29;--bd:#2c3242;--ac:#7aa7ff;--bt:#0b1020;--pk:#ff6fb1;--bad:#35191d;--badb:#ff7a85;--ok:#14291d;--okb:#4fd08a;--mut:#9aa2b8;--sh:none;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0f1219;--fg:#eceef4;--card:#1a1e29;--bd:#2c3242;--ac:#7aa7ff;--bt:#0b1020;--pk:#ff6fb1;--bad:#35191d;--badb:#ff7a85;--ok:#14291d;--okb:#4fd08a;--mut:#9aa2b8;--sh:none;color-scheme:dark}
html,body{margin:0}
body{background:var(--bg);color:var(--fg);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding-bottom:96px}
header{position:sticky;top:0;z-index:5;background:#14305f;color:#fff;box-shadow:0 2px 10px rgba(0,0,0,.2);padding-top:env(safe-area-inset-top,0px)}
.hb{max-width:720px;margin:0 auto;padding:10px 14px 8px;display:flex;align-items:center;gap:12px}
.hb img{height:34px;background:#fff;border-radius:8px;padding:2px 6px}.hb b{font-size:17px;display:block;line-height:1.15}.hb small{opacity:.8;font-size:12px}
.steps{max-width:720px;margin:0 auto;padding:0 14px 10px;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}
.steps button{margin:0;flex:none;padding:4px 12px;min-height:30px;border-radius:999px;background:rgba(255,255,255,.14);color:#fff;font-size:13px;font-weight:500}
.steps button.dn{background:rgba(255,255,255,.3)}.steps button.on{background:#fff;color:#14305f;font-weight:700}
main,footer{max-width:720px;margin:0 auto;padding:14px}footer{text-align:center;padding-top:0}
h2{font-size:19px;margin:0 0 4px}h3{font-size:15px;margin:0 0 4px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:16px;margin-bottom:14px;box-shadow:var(--sh)}
label{display:block;margin:12px 0 4px;font-size:13px;font-weight:600;color:var(--mut)}
input,textarea{width:100%;box-sizing:border-box;font:inherit;padding:12px;min-height:46px;border:1px solid var(--bd);border-radius:10px;background:var(--bg);color:var(--fg)}
input:focus,textarea:focus{outline:2px solid var(--ac);border-color:transparent}
button{font:inherit;font-weight:600;padding:12px 18px;min-height:44px;border:0;border-radius:10px;background:var(--ac);color:var(--bt);margin-top:10px;cursor:pointer}
button.sec{background:transparent;color:var(--fg);border:1px solid var(--bd)}button.wide{width:100%}
button.big{display:flex;gap:14px;align-items:center;width:100%;text-align:left;background:var(--card);color:var(--fg);border:1px solid var(--bd);box-shadow:var(--sh);padding:18px;font-size:18px;border-radius:14px;margin-top:12px}
button.big .ic{font-size:30px}button.big small{display:block;font-weight:400;font-size:13px;color:var(--mut)}
#rs{background:none;border:0;color:var(--mut);font-weight:400;text-decoration:underline;margin:0;min-height:0}
.row{border:1px solid var(--bd);border-left:5px solid var(--bd);border-radius:12px;padding:12px;margin-bottom:10px;background:var(--card);box-shadow:var(--sh)}
.row.ok{border-left-color:var(--okb)}.row.bad{border-left-color:var(--badb);background:var(--bad)}
.rh{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.rh b{flex:1}.rh .no{color:var(--mut);font-weight:400;margin-right:8px}
.chip{flex:none;min-width:54px;text-align:center;padding:3px 10px;border-radius:999px;font-weight:700;background:var(--bd);color:var(--mut)}
.row.ok .chip{background:var(--ok);color:var(--okb)}.row.bad .chip{background:var(--badb);color:#fff}
.g{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 0 8px}.g small{display:block;color:var(--mut);font-size:12px;font-weight:600;margin-bottom:2px}
.ent{display:flex;gap:4px}.ent input{min-width:0}.ent button{margin:0;padding:6px 10px;min-height:46px}
.st{font-size:13px;color:var(--mut);margin-top:4px}.st b{font-size:17px;color:var(--fg)}.st button{margin:0;padding:0 8px;min-height:0;border:0}
.kom{margin-top:2px}.fl{display:flex;gap:8px;margin-top:10px}.fl button{margin:0;padding:6px 14px;min-height:36px;font-size:14px}.fl button.on{background:var(--ac);color:var(--bt);border-color:var(--ac)}
#m[data-flt="bad"] .row:not(.bad),#m[data-flt="un"] .row:not(.un){display:none}
.bar{position:fixed;left:0;right:0;bottom:0;z-index:5;background:var(--card);border-top:1px solid var(--bd);padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px))}
.bi{max-width:720px;margin:0 auto;display:flex;gap:10px;align-items:center;justify-content:space-between}.bi button{margin:0;flex:none;min-width:96px}.bi .mut{flex:1;text-align:center}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.stats div{background:var(--bg);border-radius:10px;padding:10px;text-align:center}.stats b{font-size:24px;display:block}.stats small{color:var(--mut)}.stats .bd b{color:var(--badb)}
canvas.sig{width:100%;height:160px;background:#fff;border:1.5px dashed #9aa2b8;border-radius:10px;touch-action:none;display:block}
.mut{color:var(--mut);font-size:14px}.li{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--bd);font-size:14px}.li button{margin:0;padding:2px 12px;min-height:34px}
canvas.sig.big{height:50vh;min-height:240px}.g2{display:flex;gap:10px;align-items:center}.g2 .kom{margin:0;flex:1}.pm{display:flex;gap:4px}.pm button{margin:0;padding:6px 14px;min-height:46px}
#stage{position:fixed;left:-10000px;top:0}
.pg{width:794px;min-height:1123px;background:#fff;color:#000;position:relative;box-sizing:border-box}
.xl{padding:24px;font:16px "Arial Narrow","Liberation Sans Narrow",Arial,sans-serif;overflow:hidden}
.xl table{border-collapse:collapse;table-layout:fixed}
.xl td{border:1px solid #000;padding:0 3px;height:24px;overflow:hidden;white-space:nowrap;box-sizing:border-box;vertical-align:bottom;font-weight:700}
.xl .b td{height:21px;vertical-align:middle}
.xl th{border:1px solid #000;font-size:15.3px;padding:0 3px;text-align:center}
.xl .n{text-align:center}.xl .v{font:14.7px Calibri,Carlito,Arial,sans-serif;text-align:right}
.z{padding:2px 75px 30px;font:13.3px/17px "Times New Roman",Times,"Liberation Serif",serif}
.z p{margin:0 0 14px}.z .h{margin:20px 0 10px 23px;font-weight:700;font-size:12px}
.z .fr{display:flex;align-items:flex-end;margin-bottom:14px}.z .fr .l{white-space:nowrap;margin-right:8px}
.z .fr .v{flex:1;border-bottom:1px dotted #000;font-weight:700;font-size:13.3px;line-height:17px;min-height:17px;padding:0 4px}
.z .dl{border-bottom:1px dotted #000;min-height:22px;line-height:22px;margin-bottom:6px}
.z td{border:1px solid #000;padding:3px 6px;font-size:11px;height:24px;vertical-align:middle}
</style></head><body>
<header><div class="hb"><img id="lg" alt=""><div><b>Kontroly zásob</b><small id="pr"></small></div></div><div class="steps" id="st"></div></header>
<main id="m"></main>
<footer><button class="sec" id="rs">Nová kontrola (smazat rozpracované)</button></footer>
<div id="stage"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
const $=s=>document.querySelector(s),K='kontrola_v1',pad=n=>String(n).padStart(2,'0');
const fresh=()=>({typ:'',prov:'',adr:'',datum:new Date().toLocaleDateString('sv'),soupis:'',prikaz:'',manazer:'',predseda:'',clenove:'',start:'',end:'',items:[],hs:'',hf:'',vhot:'',vkon:'',sp:'',sm:'',step:0});
function load(){try{return JSON.parse(localStorage.getItem(K))}catch(e){return null}}
let S=Object.assign(fresh(),load()||{}),step=S.step||0;
function save(){S.step=step;try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}}
const E=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fD=i=>{if(!i)return'';const[y,m,d]=i.slice(0,10).split('-');return+d+'. '+ +m+'. '+y};
const fT=t=>t?fD(t)+' '+t.slice(11,16):'';
const now=()=>new Date().toLocaleString('sv').slice(0,16).replace(' ','T');
const food=()=>S.typ==='food';
const steps=()=>['typ','hlav','pol','kon','kom',...(food()?['zap']:[]),'pds',...((S.manazer||'').trim()?['pdm']:[]),'vys'];
const N=v=>{const x=parseFloat(String(v??'').replace(/\s/g,'').replace(',','.'));return isNaN(x)?null:x};
const diff=it=>{const s=N(it.s),d=N(it.d);return s===null||d===null?null:Math.round((s-d)*1000)/1000};
const fmt=x=>x===null||x===undefined?'':String(x).replace('.',',');
const mon=()=>{const d=new Date(S.datum+'T12:00:00');if(isNaN(d))return'';d.setDate(d.getDate()-(d.getDay()+6)%7);return String(d.getFullYear()).slice(2)+pad(d.getMonth()+1)+pad(d.getDate())};
const sug=()=>mon()&&S.prov?mon()+'-'+S.prov:'';
const psug=()=>mon()+((S.predseda||'').trim()[0]||'').toUpperCase();
const nm=()=>food()?'provozovny':'prodejny';
const warn=t=>{$('#pr').textContent=t;scrollTo(0,0)};
const f=(k,l,t='text',ph='')=>`<label>${l}<input data-k="${k}" type="${t}" value="${E(S[k])}" placeholder="${E(ph)}"></label>`;
const ta=(k,l,r=3)=>`<label>${l}<textarea data-k="${k}" rows="${r}">${E(S[k])}</textarea></label>`;
const hd=()=>{const a=N(S.hs),b=N(S.hf);return a===null||b===null?'':fmt(Math.round((b-a)*100)/100)+' Kč'};

const sigv=(k,t,n)=>`<div class="card"><h2>${t}</h2><p>${E(n)}</p><canvas class="sig big" data-k="${k}"></canvas><button class="sec" data-clr="${k}">Smazat podpis</button></div>`;
const LBL={typ:'Typ',hlav:'Hlavička',pol:'Položky',kon:'Kontrola',zap:'Zápis',kom:'Komise',pds:'Předseda',pdm:'Manažer',vys:'PDF'};
const ent=(i,f,l)=>`<div><small>${l}</small><div class="ent"><input inputmode="decimal" data-ei="${i}" data-ef="${f}" placeholder="např. +5"></div><div class="st">Stav: <b id="v${i}${f}"></b> <button class="sec" data-rst="${i}:${f}">×</button></div></div>`;
const V={
typ:()=>`<div class="card"><h2>Nová kontrola</h2><p class="mut">Vyberte typ kontroly.</p><button class="big" data-t="food"><span class="ic">🍽️</span><span>Foodservice<small>Soupis + zápis o kontrole</small></span></button><button class="big" data-t="te"><span class="ic">🚬</span><span>Tabák / trafika<small>Pouze soupis</small></span></button>${S.items.length?`<p class="mut" style="margin-top:14px">Rozpracováno: ${S.items.length} položek. Pokračujte výběrem stejného typu.</p>`:''}</div><div class="card"><h3>Příprava z počítače</h3><p class="mut">Vložte text vytvořený na počítači (krok Položky → Přenést na mobil). Nahradí rozpracovanou kontrolu.</p><textarea id="paste" rows="4" placeholder="KONTROLA|food|…"></textarea><button class="wide" data-a="impgo">Načíst a začít kontrolu</button></div>`,
hlav:()=>`<div class="card"><h2>Hlavička kontroly</h2>${f('prov','Číslo '+nm(),'text')}${f('adr',food()?'Adresa provozovny':'Název prodejny')}${f('datum','Datum kontroly','date')}${food()?f('soupis','Číslo soupisu','text',sug()):''}</div>`,
pol:()=>`<div class="card"><h2>Položky ke kontrole</h2><p class="mut">Vložte seznam položek z Excelu nebo Power BI (jeden název na řádek). Dispozici doplníte v dalším kroku.</p><textarea id="paste" rows="6"></textarea><button data-a="imp">Načíst položky</button></div>
<div class="card"><h3>Přidat ručně</h3><input id="an" placeholder="Název"><button data-a="add">Přidat</button></div>
<div class="card"><h3>Seznam (${S.items.length})</h3>${S.items.map((it,i)=>`<div class="li"><span>${E(it.n)}</span><button class="sec" data-del="${i}">×</button></div>`).join('')}${S.items.length?'<button class="sec" data-a="clr">Smazat vše</button>':''}</div>
<div class="card"><h3>Přenést na mobil</h3><p class="mut">Vytvoří text s položkami, dispozicemi a hlavičkou. Pošlete si ho (např. do Teams) a na mobilu vložte na úvodní obrazovce.</p><button class="sec" data-a="xp">Vytvořit text pro mobil</button><textarea id="xp" rows="6" readonly style="display:none;margin-top:8px"></textarea><p class="mut" id="xm"></p></div>`,
kon:()=>`<div class="card"><h2>Dispozice a kontrola</h2><p class="mut">Číslo nahradí stav, +číslo přičte, -číslo odečte, =-číslo nastaví záporný stav. Potvrdíte Enterem nebo klepnutím jinam.</p><div class="fl"><button class="sec on" data-fl="">Vše</button><button class="sec" data-fl="un">Nevyplněné</button><button class="sec" data-fl="bad">Rozdíly</button></div></div>`+S.items.map((it,i)=>`<div class="row" id="r${i}"><div class="rh"><b><span class="no">${i+1}</span>${E(it.n)}</b><span class="chip" id="res${i}"></span></div><div class="g">${ent(i,'d','Dispozice')}${ent(i,'s','Skutečnost')}</div><div class="g2"><div class="pm"><button class="sec" data-sg="+">+</button><button class="sec" data-sg="-">−</button></div><input class="kom" placeholder="Komentář" data-i="${i}" data-f="k" value="${E(it.k)}"></div></div>`).join('')+`<div class="card"><h3>Přidat položku navíc</h3><input id="an" placeholder="Název"><input id="ad" inputmode="decimal" placeholder="Dispozice (nepovinné)" style="margin-top:8px"><button data-a="add">Přidat</button></div>`,
zap:()=>`<div class="card"><h2>Zápis o průběhu kontroly</h2>${f('prikaz','Příkaz k provedení FI č. (pondělí týdne + iniciála předsedy, lze upravit)')}${f('start','Počátek kontroly','datetime-local')}${f('end','Konec kontroly','datetime-local')}</div>
<div class="card"><h3>Inventura pokladní hotovosti</h3>${f('hs','Stav hotovosti v systému (Kč)')}${f('hf','Stav hotovosti fyzicky (Kč)')}<p>Rozdíl: <b id="hd">${hd()}</b></p>${ta('vhot','Vyjádření k pokladní hotovosti')}</div>
<div class="card"><h3>Fyzická kontrola zboží</h3>${ta('vkon','Vyjádření ke kontrole',6)}<button class="sec" data-a="auto">Předvyplnit z výsledků</button></div>`,
kom:()=>`<div class="card"><h2>Komise</h2><p class="mut">Kdo kontrolu provedl. Podpisy následují v dalších krocích.</p>${f('predseda','Předseda IK (kontrolující) – jméno a příjmení')}${f('manazer','Manažer '+nm()+' – jméno a příjmení (pokud je přítomen)')}${food()?ta('clenove','Další členové komise (každý na nový řádek)',2):''}</div>`,
pds:()=>sigv('sp','Podpis předsedy IK',S.predseda),
pdm:()=>sigv('sm','Podpis manažera',S.manazer),
vys:()=>{const a=S.items,d=a.filter(i=>diff(i)).length,u=a.filter(i=>N(i.s)===null).length;return`<div class="card"><h2>Hotovo</h2><div class="stats"><div><b>${a.length}</b><small>položek</small></div><div class="${d?'bd':''}"><b>${d}</b><small>s rozdílem</small></div><div><b>${u}</b><small>nevyplněných</small></div></div>${S.sp?'':'<p class="mut">Chybí podpis předsedy, v dokumentu zůstane prázdné místo.</p>'}</div><div class="card"><h3>Dokumenty</h3><button class="wide" data-a="gs">⬇ Soupis (PDF)</button>${food()?'<button class="wide" data-a="gz">⬇ Zápis o kontrole (PDF)</button>':''}<p class="mut" id="msg"></p></div>`}};

function render(){const n=steps()[step]||'typ';$('#m').dataset.flt='';$('#pr').textContent=S.typ?(food()?'Foodservice':'Tabák / trafika'):'Soupisy a zápisy z kontrol';$('#st').innerHTML=S.typ?steps().map((x,i)=>`<button data-go="${i}" class="${i==step?'on':i<step?'dn':''}">${LBL[x]}</button>`).join(''):'';const ao=$('#st .on');if(ao)ao.scrollIntoView({inline:'center',block:'nearest'});$('#m').innerHTML=V[n]()+nav();if(n==='kon')S.items.forEach((_,i)=>upd(i));if(n==='pds'||n==='pdm')pads();save()}
function nav(){const i=step,l=steps().length,n=steps()[i];return`<div class="bar"><div class="bi">${i?'<button class="sec" data-a="prev">‹ Zpět</button>':'<span></span>'}<span class="mut" id="sum"></span>${i<l-1&&n!=='typ'?'<button data-a="next">Další ›</button>':'<span></span>'}</div></div>`}
function upd(i){const it=S.items[i],d=diff(it),r=$('#r'+i);if(!r)return;$('#res'+i).textContent=d===null?'–':fmt(d);r.classList.toggle('bad',!!d);r.classList.toggle('ok',d===0);r.classList.toggle('un',d===null);['d','s'].forEach(f=>$('#v'+i+f).textContent=N(it[f])===null?'–':fmt(N(it[f])));const t=S.items.filter(x=>N(x.s)!==null).length;$('#sum').textContent='Vyplněno '+t+'/'+S.items.length+' · rozdíly '+S.items.filter(x=>diff(x)).length}
function commit(t){const i=+t.dataset.ei,f=t.dataset.ef,it=S.items[i],v=t.value.trim().replace(',','.');if(!v)return;const x=N(v.replace(/^[+=-]/,''));t.value='';if(x===null)return;const c=N(it[f])??0,g=v[0];const r=g==='+'?c+x:g==='-'?c-x:x;it[f]=String(Math.round(r*1000)/1000);upd(i);save()}
function go(n){step=Math.max(0,Math.min(steps().length-1,n));const s=steps()[step];if(s==='kon'&&food()&&!S.start)S.start=now();if(s==='vys'&&food()&&!S.end)S.end=now();if(s==='zap'&&!S.vkon)S.vkon=auto();if(s==='zap'&&!S.pkM)S.prikaz=psug();render();scrollTo(0,0)}
function auto(){const t=S.items.filter(i=>N(i.s)!==null).length,d=S.items.filter(i=>diff(i)).map(i=>i.n+': '+fmt(diff(i)));return'Zkontrolováno '+t+' položek.'+(d.length?' Rozdíl zjištěn u '+d.length+' položek:\n'+d.join('\n'):' Nebyl zjištěn žádný rozdíl.')}
function imp(){$('#paste').value.split('\n').forEach(l=>{l=l.replace(/\r/,'').trim();if(!l)return;let n,d;if(l.startsWith('KONTROLA|')){const h=l.split('|');if(h[1])S.typ=h[1];S.prov=h[2]||'';S.adr=h[3]||'';S.soupis=h[5]||'';return}const c=l.includes('|')?l.split('|'):l.split('\t');if(c.length>1){n=(c.length>2&&/^\d+$/.test(c[0].trim())?c[1]:c[0]).trim();d=c[c.length-1]}else{n=l;d=''}if(n&&(d===''||N(d)!==null))S.items.push({n,d:d===''?'':String(N(d)),s:'',k:''})});render()}
function xp(){const l=[['KONTROLA',S.typ,S.prov,S.adr,'',S.soupis].join('|'),...S.items.map(i=>i.n+'|'+(i.d||''))].join('\n'),a=$('#xp');a.value=l;a.style.display='block';a.focus();a.select();let ok=false;try{ok=document.execCommand('copy')}catch(e){}$('#xm').textContent=ok?'Zkopírováno. Pošlete si text třeba do Teams a na mobilu ho vložte na úvodní obrazovce.':'Text označte a zkopírujte ručně, pak ho na mobilu vložte na úvodní obrazovce.'}
function pads(){document.querySelectorAll('canvas.sig').forEach(c=>{const k=c.dataset.k,x=c.getContext('2d'),w=c.offsetWidth,h=c.offsetHeight;c.width=w*2;c.height=h*2;x.scale(2,2);x.lineWidth=2.2;x.lineCap='round';x.strokeStyle='#111';
if(S[k]){const im=new Image();im.onload=()=>x.drawImage(im,0,0,w,h);im.src=S[k]}
let dr=0;const p=e=>{const r=c.getBoundingClientRect();return[e.clientX-r.left,e.clientY-r.top]};
c.onpointerdown=e=>{dr=1;c.setPointerCapture(e.pointerId);const[a,b]=p(e);x.beginPath();x.moveTo(a,b);x.lineTo(a+.1,b+.1);x.stroke()};
c.onpointermove=e=>{if(!dr)return;const[a,b]=p(e);x.lineTo(a,b);x.stroke()};
c.onpointerup=()=>{dr=0;S[k]=c.toDataURL('image/png');save()}})}

